#!/usr/bin/env bash
# Fails when a tracked or staged text file does not end with a newline.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

status=0
while IFS= read -r -d '' file; do
  [ -f "$file" ] && [ -s "$file" ] || continue
  grep -Iq . "$file" || continue # skip binary files
  if [ "$(tail -c 1 "$file" | od -An -c | tr -d ' ')" != '\n' ]; then
    echo "missing final newline: $file"
    status=1
  fi
done < <(git ls-files -z --cached --others --exclude-standard)

if [ "$status" -eq 0 ]; then
  echo "check-text-files: all text files end with a newline"
fi
exit "$status"
